<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TutorialNinjaSuite" parallel="classes" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.qa.listeners.TestListener"/>
        <listener class-name="com.qa.utils.RetryListener"/>
    </listeners>

    <test name="LoginTests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.qa.tests.LoginTest"/>
        </classes>
    </test>

    <test name="SearchTests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.qa.tests.SearchTest"/>
        </classes>
    </test>

    <test name="CartTests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.qa.tests.AddToCartTest"/>
        </classes>
    </test>

    <test name="CheckoutE2ETests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.qa.tests.CheckoutE2ETest"/>
        </classes>
    </test>

</suite>
